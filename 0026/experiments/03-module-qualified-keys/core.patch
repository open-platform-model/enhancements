-#ContractFQNType: string & =~"^[a-z0-9._-]+(/[a-z0-9._-]+)*/[a-z0-9]([a-z0-9-]*[a-z0-9])?@v[0-9]+((alpha|beta)[0-9]+)?$"
+#ContractFQNType: string & =~"^[a-z0-9._-]+(/[a-z0-9._-]+)*(@v[0-9]+/[a-z0-9._-]+(/[a-z0-9._-]+)*)?/[a-z0-9]([a-z0-9-]*[a-z0-9])?@v[0-9]+((alpha|beta)[0-9]+)?$"
+
+// LINEAGE PROBE: #ContractRef decomposes a contract key. A module-qualified
+// key ("<path>@vN/<kind>/<name>@<apiVersion>") names its declaring catalog
+// entry (the #registry key) and its lineage (the major-free path); a
+// registry-scoped (legacy) key names neither.
+#ContractRef: {
+	fqn!:      #ContractFQNType
+	_m:        regexp.FindSubmatch("^([a-z0-9._-]+(/[a-z0-9._-]+)*)(@v[0-9]+)?(/[a-z0-9._-]+)*/([a-z0-9]([a-z0-9-]*[a-z0-9])?)@(v[0-9]+((alpha|beta)[0-9]+)?)$", fqn)
+	qualified: _m[3] != ""
+	if qualified {
+		declaringModule: _m[1] + _m[3]
+		lineage:         _m[1]
+		// the key with the major removed: equal across majors of one lineage
+		lineageKey: _m[1] + strings.TrimPrefix(fqn, _m[1]+_m[3])
+	}
+	apiVersion: _m[7]
+}
 
